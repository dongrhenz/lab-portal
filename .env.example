# Copy this file to .env and fill in real values before deploying.

# UNC path to the LIS PDF results share, e.g.:
#   LIS_ROOT=\\172.22.60.5\SBSI LIS Pro
# On Linux, mount the SMB share first and point this at the local mount point instead.
LIS_ROOT=\\172.22.60.5\SBSI LIS Pro

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

PORT=3000
NODE_ENV=production
FORCE_HTTPS=true
