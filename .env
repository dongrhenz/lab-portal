# Generated for an initial local test against the real LIS share.
# NOT safe for real patients yet — see the checklist notes below and in README.md
# ("Running in production") before exposing this to anyone but you on your machine.

# Parent of the daily result folders (NOT a specific day's folder) — the app scans
# every ".PDF Results<YYYYMMDD>" subfolder under this path itself.
LIS_ROOT=\\172.22.60.5\SBSI LIS Pro

# Randomly generated — keep this secret, do not commit it.
SESSION_SECRET=1f90c3e160271546091d6d871078ccf7c63388e31a5d0a21ebf335cb7ed2c402

PORT=3000

# Left in dev mode for this first test: no reverse proxy in front of it yet, so
# cookies aren't forced to HTTPS-only (they'd never be sent otherwise) and
# trust proxy stays off. Flip NODE_ENV=production, FORCE_HTTPS=true, and set
# TRUST_PROXY once this sits behind a real reverse proxy for actual patient use.
NODE_ENV=development
FORCE_HTTPS=false
TRUST_PROXY=false
